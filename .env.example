# =============================================================================
# CoFounderBay — Environment Configuration
# Copy this file to `.env.local` and fill in the values.
# All client-exposed variables MUST be prefixed with VITE_ (Vite requirement).
# =============================================================================

# --- AI (Gemini) -------------------------------------------------------------
# Required for Gemini AI features. AI Studio injects GEMINI_API_KEY at runtime.
# SECURITY: in production, proxy AI calls through a backend so the key is never
# shipped to the browser. VITE_GEMINI_API_KEY is read by the client directly.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Route AI calls through the server-side proxy (POST /api/ai/generate) so the
# key never ships in the client bundle. Defaults to "true" in production
# builds; set explicitly to override. The server reads GEMINI_API_KEY (above).
VITE_AI_USE_PROXY=""

# Server-side proxy rate limit (requests per minute per member token, or per IP
# for anonymous calls). Default: 30.
AI_RATE_LIMIT_PER_MINUTE="30"

# Model the proxy uses (and the only one it forwards unless allow-listed below).
GEMINI_MODEL="gemini-flash-latest"
# Extra models a client may request, comma-separated. Anything else falls back
# to GEMINI_MODEL, so a caller cannot pick an arbitrarily expensive model.
AI_MODEL_ALLOWLIST=""
# Ceiling on output tokens per proxied call. Default: 2048.
AI_MAX_OUTPUT_TOKENS="2048"

# Require a signed-in member (Firebase ID token) for /api/ai/*. Default: on in
# production, off in development. "false" serves anonymous calls from a smaller
# bucket instead; a bad token is rejected either way.
AI_REQUIRE_AUTH=""
# Anonymous bucket when sign-in is not required. Default: a third of
# AI_RATE_LIMIT_PER_MINUTE.
AI_ANON_RATE_LIMIT_PER_MINUTE=""
# Firebase project whose ID tokens the proxy accepts. Falls back to
# VITE_FIREBASE_PROJECT_ID, then firebase-applet-config.json.
FIREBASE_PROJECT_ID=""

# Origins allowed to call the API and Socket.IO, comma-separated ("*" for any).
# Default: APP_URL in production, localhost in development.
CORS_ORIGINS=""

# --- Outreach: due-diligence links, email, weekly digest (server/outreach.ts) ---
# Same sign-in rule as the AI proxy (AI_REQUIRE_AUTH). Where its records live:
#   firestore — Firestore through the service account (Application Default
#               Credentials). The default on Cloud Run. The account needs the
#               "Cloud Datastore User" role; collections are outreach_* and
#               firestore.rules keeps every client out of them.
#   file      — JSON files in OUTREACH_DATA_DIR. The default elsewhere; only
#               for one long-running server with a disk that survives restarts.
#   memory    — nothing kept across restarts.
OUTREACH_STORE=""
OUTREACH_DATA_DIR=".data"
# Firestore target. Defaults: the app's own project and named database
# (firebase-applet-config.json), collections prefixed "outreach_".
OUTREACH_FIRESTORE_PROJECT=""
OUTREACH_FIRESTORE_DATABASE=""
OUTREACH_FIRESTORE_PREFIX=""
# Email: empty = nothing is sent; messages are logged as "queued" and the app
# says so. "smtp" sends through any SMTP server.
EMAIL_PROVIDER=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
# true for port 465 (implicit TLS); STARTTLS is used on 587 automatically.
SMTP_SECURE=""
# Weekly digest: an hourly scheduler calls POST /api/cron/digest with
# "Authorization: Bearer <DIGEST_CRON_SECRET>". Or set DIGEST_SCHEDULER=on on a
# long-running server to check every 10 minutes in-process.
DIGEST_CRON_SECRET=""
DIGEST_SCHEDULER=""

# Optional local Ollama endpoint (free/local AI strategy). Default shown.
VITE_OLLAMA_BASE_URL="http://localhost:11434"

# --- App ---------------------------------------------------------------------
# Public URL where the app is hosted (self-links, OAuth callbacks).
APP_URL="MY_APP_URL"
VITE_APP_URL="http://localhost:5180"
VITE_APP_NAME="CoFounderBay"

# Optional explicit API base URL. Leave empty for same-origin requests.
VITE_API_BASE_URL=""

# --- Firebase (optional override) --------------------------------------------
# If unset, the app falls back to firebase-applet-config.json. Set these to
# point staging/production at different Firebase projects.
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_FIRESTORE_DB_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# --- Observability (optional) ------------------------------------------------
VITE_ENABLE_ANALYTICS="false"
VITE_ANALYTICS_WRITE_KEY=""
VITE_ENABLE_ERROR_TRACKING="false"
VITE_SENTRY_DSN=""
